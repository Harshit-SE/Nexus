# ============================================================
# Nexus Chat Agent — Environment Variables
# ============================================================
# Copy this file to .env.local and configure your preferred provider.

# ------------------------------------------------------------
# 1. LLM Provider Options:
#    - 'ollama' (Local Phi-3 / Llama-3 via Ollama - 100% free & local)
#    - 'gemini' (Cloud Gemini Flash via Google AI Studio)
# ------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3

# ------------------------------------------------------------
# 2. Cloud Fallback: Google AI Studio API Key
#    Get it free at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_key_here

# ------------------------------------------------------------
# 3. Web Search API Key: Brave Search API
#    Get it free at: https://api.search.brave.com/register
#    Free tier: 2,000 queries/month
# ------------------------------------------------------------
BRAVE_API_KEY=your_brave_search_api_key_here

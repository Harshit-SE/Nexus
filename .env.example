# ==============================================================================
# NEXUS AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary LLM Provider: 'nemotron' | 'ollama' | 'gemini'
LLM_PROVIDER=nemotron

# NVIDIA NIM / Nemotron Configuration (Recommended Cloud Provider)
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Local Ollama Configuration (Default Local Fallback)
# Install from https://ollama.ai and run: ollama pull phi3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3

# Google Gemini API Key (Cloud Fallback)
# Get a key at: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Web Search Provider: 'hermes' (high-precision real-time engine)
SEARCH_PROVIDER=hermes
